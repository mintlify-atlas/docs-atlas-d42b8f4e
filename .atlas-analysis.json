  "keyFeatures": [
    "Role-based access control with Visitor, Student, and Administrator permission levels",
    "Equipment catalog with availability filtering and status tracking",
    "Shopping cart system for batching equipment loan requests",
    "Individual equipment loan requests with start/end dates, professor, and subject fields",
    "Admin dashboard with real-time statistics on active loans, pending requests, and available equipment",
    "Full inventory management: add, edit, and delete lab equipment with image uploads",
    "User management: view, edit permissions, and remove users",
    "Loan history tracking with filterable records",
    "Access request workflow for visitors to gain student-level permissions"
  ],
  "publicApiSurface": [
    "GET /login — User authentication page",
    "POST /login — Submit credentials",
    "GET /register — Registration page",
    "POST /register — Create new account",
    "GET /logout — End session",
    "GET /Catalogo — Browse available equipment",
    "GET /solicitar/<IDequipo> — Equipment loan request form",
    "POST /enviar_solicitud — Submit loan request",
    "GET /agregar-carrito/<IDequipo> — Add equipment to cart",
    "GET /quitar-carrito/<IDequipo> — Remove equipment from cart",
    "GET /Carrito — View cart contents",
    "GET /solicitar_todo_carrito — Submit all cart items as request",
    "GET /cancelar_solicitud_carrito — Cancel pending cart request",
    "GET /perfilUsuario — View user profile and loan history",
    "GET /Editar/<solicitud_id> — Edit pending loan request",
    "POST /ActualizarSolicitud — Save loan request changes",
    "GET /Cancelar/<solicitud_id> — Cancel a loan request",
    "GET /Devolver/<solicitud_id> — Mark equipment as returned",
    "GET /solicitarAccesoMenu — Access upgrade request page",
    "POST /SolicitarAcceso — Submit access upgrade request",
    "GET /home — Admin dashboard",
    "GET /lista_Pedidos — Active loans list (admin)",
    "GET /lista_solicitudes — Pending loan requests (admin)",
    "GET /Inventario — Equipment inventory (admin)",
    "GET /ListaUsuario — User list (admin)",
    "GET /Historial — Loan history (admin)"
  ]
}
